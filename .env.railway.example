# Sample environment variables for Railway deployment.
# Copy these into your Railway service's "Variables" tab.
# Use Railway reference variables (${{Plugin.VAR}}) to wire managed Postgres/Redis.

# ----- App -----
APP_ENV=production
APP_NAME=extension-erp-api
# APP_PORT is intentionally unset; the API falls back to Railway's $PORT.

# ----- CORS -----
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ----- Postgres (Railway Postgres plugin) -----
# Reference variables from the attached Postgres service:
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_NAME=${{Postgres.PGDATABASE}}
# Railway Postgres requires TLS.
DB_SSLMODE=require

# ----- Redis (Railway Redis plugin) -----
# Railway exposes REDIS_URL as redis://default:<pass>@<host>:<port>
# go-redis expects host:port + password separately, so map them:
REDIS_ADDR=${{Redis.REDISHOST}}:${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_DB=0

# ----- JWT -----
# Generate a strong random secret, e.g. `openssl rand -hex 64`.
JWT_SECRET=replace-with-strong-random-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=168
