# Server
APP_ENV=development
APP_PORT=8080
APP_NAME=extension-erp-api

# CORS — comma-separated list of allowed browser origins.
# Add staging + production domains here at deploy time.
# Examples:
#   dev:   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
#   prod:  CORS_ALLOWED_ORIGINS=https://erp.example.com,https://staging.erp.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Postgres — points to dberphm. Schema auth.* is owned by worker-erp.
# BE only reads auth.* and writes to auth.users.password_hash / password_generated_at.
DB_HOST=89.21.85.6
DB_PORT=5432
DB_USER=usererphm
DB_PASSWORD=replace-me
DB_NAME=dberphm
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=168
